// ============ Translation ============
async function translateWithBaidu(text, fromLang = 'en', toLang = 'zh') {
  if (!text || text.length < 2) return { success: false, text: null };
  try {
    const salt = Date.now();
    const sign = md5(BAIDU_APP_ID + text.substring(0, 200) + salt + BAIDU_SECRET_KEY);
    const params = `?q=${encodeURIComponent(text.substring(0, 200))}&from=${fromLang}&to=${toLang}&appid=${BAIDU_APP_ID}&salt=${salt}&sign=${sign}`;
    const url = `https://fanyi-api.baidu.com/api/trans/vip/translate${params}`;
    const resp = await Promise.race([
      fetch(url, { signal: AbortSignal.timeout(5000) }),
      new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 5000))
    ]);
    if (!resp.ok) return { success: false, text: null };
    const data = await resp.json();
    if (data.trans_result && data.trans_result[0]) {
      return { success: true, text: data.trans_result[0].dst };
    }
    return { success: false, text: null };
  } catch (e) {
    console.log('Baidu translate error:', e.message);
    return { success: false, text: null };
  }
}

async function translateNews(newsItems) {
  for (let i = 0; i < newsItems.length; i++) {
    const item = newsItems[i];
    const titleResult = await translateWithBaidu(item.title, 'en', 'zh');
    item.titleZh = titleResult.success ? titleResult.text : null;
    if (item.summary && item.summary.length > 10) {
      const summaryResult = await translateWithBaidu(item.summary.substring(0, 180), 'en', 'zh');
      item.summaryZh = summaryResult.success ? summaryResult.text : null;
    } else {
      item.summaryZh = null;
    }
    console.log(`[${i+1}/${newsItems.length}] ${item.titleZh ? 'OK' : 'FAIL'} ${item.title.substring(0, 30)}...`);
    await new Promise(r => setTimeout(r, 300));
  }
  return newsItems;
}

// ============ RSS Parsing ============
function parseItemXml(xml, tagName) {
  const regex = new RegExp(`<${tagName}[^>]*>([\\s\\S]*?)<\\/${tagName}>`, 'i');
  const match = xml.match(regex);
  return match ? match[1].replace(/<[^>]*>/g, '').trim() : '';
}

function parseRSS(xmlText, sourceName) {
  const results = [];
  const itemRegex = /<item[^>]*>([\s\S]*?)<\/item>/gi;
  let match;
  const AI_KEYWORDS = ['AI', 'Artificial Intelligence', 'Machine Learning', 'Deep Learning', 'Neural Network', 'LLM', 'ChatGPT', 'OpenAI', 'GPT', 'Gemini', 'Claude', 'Anthropic', 'Stable Diffusion', 'Midjourney', 'AI Model', 'Transformer', 'Diffusion'];
  
  while ((match = itemRegex.exec(xmlText)) !== null) {
    const itemXml = match[1];
    const title = parseItemXml(itemXml, 'title');
    const link = parseItemXml(itemXml, 'link');
    const description = parseItemXml(itemXml, 'description') || parseItemXml(itemXml, 'summary') || parseItemXml(itemXml, 'content');
    const pubDate = parseItemXml(itemXml, 'pubDate') || parseItemXml(itemXml, 'published') || parseItemXml(itemXml, 'updated');
    
    if (!title || !link) continue;
    const isExcluded = EXCLUDED_DOMAINS.some(domain => link.includes(domain));
    if (isExcluded) continue;
    const isAIRelated = AI_KEYWORDS.some(kw => title.includes(kw) || (description && description.includes(kw)));
    
    results.push({
      title,
      url: link,
      summary: (description || '').substring(0, 300),
      source: sourceName,
      pubDate,
      isAIRelated
    });
  }
  return results;
}

async function fetchAINews() {
  const allNews = [];
  for (const source of NEWS_SOURCES) {
    try {
      const response = await fetchWithTimeout(source.url, {
        headers: { 'User-Agent': 'AI-News-Digest/1.0' }
      });
      if (!response.ok) { console.log(`${source.name}: HTTP ${response.status}`); continue; }
      const xmlText = await response.text();
      const news = parseRSS(xmlText, source.name);
      const aiNews = news.filter(n => n.isAIRelated);
      console.log(`${source.name}: ${news.length} total, ${aiNews.length} AI-related`);
      allNews.push(...aiNews);
    } catch (e) {
      console.log(`Failed to fetch ${source.name}: ${e.message}`);
    }
  }
  console.log(`Total AI news before dedup: ${allNews.length}`);
  const seen = new Set();
  return allNews.filter(item => {
    if (seen.has(item.url)) return false;
    seen.add(item.url);
    return true;
  }).slice(0, 15);
}

async function fetchGithubTools() {
  try {
    const response = await fetchWithTimeout(GITHUB_API, {
      headers: { 'Accept': 'application/vnd.github.v3+json', 'User-Agent': 'AI-News-Digest/1.0' }
    });
    if (!response.ok) return [];
    const data = await response.json();
    return (data.items || []).slice(0, 12).map(repo => ({
      name: repo.full_name,
      url: repo.html_url,
      description: repo.description || 'No description',
      stars: repo.stargazers_count,
      language: repo.language,
      avatar: repo.owner.avatar_url
    }));
  } catch (e) {
    console.log(`Failed to fetch GitHub tools: ${e.message}`);
    return [];
  }
}

async function fetchOGImage(url) {
  try {
    const response = await fetchWithTimeout(url, {
      headers: { 'User-Agent': 'Mozilla/5.0 (compatible; AI-News-Digest/1.0)' }
    });
    if (!response.ok) return null;
    const html = await response.text();
    const ogImageMatch = html.match(/<meta[^>]*property=["']og:image["'][^>]*content=["']([^"']+)["']/i) ||
                         html.match(/<meta[^>]*content=["']([^"']+)["'][^>]*property=["']og:image["']/i);
    if (ogImageMatch) return ogImageMatch[1];
    const twitterImageMatch = html.match(/<meta[^>]*name=["']twitter:image["'][^>]*content=["']([^"']+)["']/i);
    if (twitterImageMatch) return twitterImageMatch[1];
    return null;
  } catch (e) {
    return null;
  }
}

async function fetchNewsData() {
  const [news, tools] = await Promise.all([fetchAINews(), fetchGithubTools()]);
  
  // Attach OG images
  const withImages = await Promise.all(
    news.map(async (item) => {
      const ogImage = await fetchOGImage(item.url);
      return { ...item, ogImage };
    })
  );
  
  // Translate
  const translated = await translateNews(withImages);
  
  return { news: translated, tools };
}

export default {
  async scheduled(controller, env, ctx) {
    const data = await fetchNewsData();
    data.updatedAt = new Date().toISOString();
    await env.AI_NEWS_KV.put('news-data', JSON.stringify(data));
    console.log(`Updated: ${data.news.length} news, ${data.tools.length} tools`);
  },

  async fetch(request, env) {
    const url = new URL(request.url);
    
    if (request.method === 'OPTIONS') {
      return new Response(null, {
        headers: { 'Access-Control-Allow-Origin': '*', 'Access-Control-Allow-Methods': 'GET, POST, OPTIONS', 'Access-Control-Allow-Headers': 'Content-Type', 'Access-Control-Max-Age': '86400' }
      });
    }
    
    if (url.searchParams.has('refresh')) {
      const data = await fetchNewsData();
      data.updatedAt = new Date().toISOString();
      await env.AI_NEWS_KV.put('news-data', JSON.stringify(data));
      const html = generatePage(data);
      return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-cache, no-store, must-revalidate', 'Access-Control-Allow-Origin': '*' } });
    }
    
    const cached = await env.AI_NEWS_KV.get('news-data');
    if (cached) {
      const data = JSON.parse(cached);
      const html = generatePage(data);
      return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'public, max-age=3600', 'Access-Control-Allow-Origin': '*' } });
    }
    
    const data = await fetchNewsData();
    const html = generatePage(data);
    return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'public, max-age=3600', 'Access-Control-Allow-Origin': '*' } });
  }
};

function escapeHtml(text) {
  if (!text) return '';
  return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function formatStars(stars) {
  if (stars >= 1000000) return (stars / 1000000).toFixed(1) + 'M';
  if (stars >= 1000) return (stars / 1000).toFixed(1) + 'k';
  return stars.toString();
}

