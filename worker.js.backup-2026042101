  html += 'function setLang(lang) { document.querySelectorAll(".lang-btn").forEach(function(b){b.classList.remove("active")}); document.querySelector(".lang-btn-" + lang).classList.add("active"); document.querySelectorAll(".card-title").forEach(function(el){var card=el.closest(".card"); el.textContent=lang==="zh"?(card.dataset.titleZh||el.dataset.origTitle):el.dataset.origTitle;}); document.querySelectorAll(".card-summary").forEach(function(el){var card=el.closest(".card"); el.textContent=lang==="zh"?(card.dataset.summaryZh||el.dataset.origSummary):el.dataset.origSummary;}); };';
  html += 'document.querySelectorAll(".card-title, .card-summary").forEach(function(el){el.dataset.origTitle=el.textContent;el.dataset.origSummary=el.textContent;});';
  html += 'let touchStartX=0,touchEndX=0; document.addEventListener("touchstart",function(e){touchStartX=e.changedTouches[0].screenX;},false); document.addEventListener("touchend",function(e){touchEndX=e.changedTouches[0].screenX; var activeTab=document.querySelector(".tab.active"); if(Math.abs(touchEndX-touchStartX)>50){ if(touchEndX<touchStartX&&activeTab.classList.contains("tab-news"))switchTab("tools"); else if(touchEndX>touchStartX&&activeTab.classList.contains("tab-tools"))switchTab("news");} },false);';
  html += '</script></head><body><div class="container"><header>';
  html += '<div class="refresh-badge">🤖 24小時內新鮮資訊</div>';
  html += '<h1>🤖 AI 新聞速遞</h1>';
  html += '<p class="subtitle">' + lastUpdated + ' | 為香港用戶精選</p>';
  html += '<div class="lang-toggle"><button class="lang-btn lang-btn-zh active" onclick="setLang(\'zh\')">🌐 中文</button><button class="lang-btn lang-btn-en" onclick="setLang(\'en\')">🌐 EN</button></div>';
  html += '</header>';
  
  // Tab navigation
  const newsCount = news.length;
  const toolsCount = tools.length;
  html += '<div class="tabs">';
  html += '<div class="tab tab-news active" onclick="switchTab(\'news\')"><span class="tab-icon">📰</span> AI 新聞 <span class="tab-count">' + newsCount + '</span></div>';
  html += '<div class="tab tab-tools" onclick="switchTab(\'tools\')"><span class="tab-icon">🛠️</span> AI 工具 <span class="tab-count">' + toolsCount + '</span></div>';
  html += '</div>';
  
  // AI News section
  html += '<div class="content-section section-news active">';
  if (news.length > 0) {
    html += '<div class="card-grid">';
    news.forEach(function(item) {
      html += '<div class="card" onclick="window.open(\'' + escapeHtml(item.url) + '\', \'_blank\')">';
      if (item.ogImage) {
        html += '<img class="card-image" src="' + escapeHtml(item.ogImage) + '" alt="" onerror="this.outerHTML=\'<div class=\\\'card-image-placeholder\\\'>📰</div>\'">';
      } else {
        html += '<div class="card-image-placeholder">📰</div>';
      }
      html += '<div class="card-body">';
      html += '<div class="card-source">' + escapeHtml(item.source) + '</div>';
      html += '<div class="card-title" data-title-zh="' + escapeHtml(item.titleZh || '') + '" data-orig-title="' + escapeHtml(item.title) + '">' + escapeHtml(item.title) + '</div>';
      html += '<div class="card-summary" data-summary-zh="' + escapeHtml(item.summaryZh || '') + '" data-orig-summary="' + escapeHtml(item.summary || '').substring(0, 200) + '">' + escapeHtml(item.summary || '').substring(0, 150) + '</div>';
      html += '</div></div>';
    });
    html += '</div>';
  } else {
    html += '<div class="empty-state"><div class="empty-state-icon">📭</div><p>暫時未能獲取新聞</p></div>';
  }
  html += '</div>';
  
  // AI Tools section
  html += '<div class="content-section section-tools">';
  if (tools.length > 0) {
    html += '<div class="card-grid">';
    tools.forEach(function(tool) {
      html += '<div class="card" onclick="window.open(\'' + escapeHtml(tool.url) + '\', \'_blank\')">';
      if (tool.avatar) {
        html += '<img class="card-image" src="' + escapeHtml(tool.avatar) + '" alt="" style="aspect-ratio:1/1;object-fit:cover;">';
      }
      html += '<div class="card-body">';
      html += '<div class="card-source">' + escapeHtml(tool.language || 'Code') + '</div>';
      html += '<div class="card-title">' + escapeHtml(tool.name) + '</div>';
      html += '<div class="card-summary">' + escapeHtml(tool.description) + '</div>';
      html += '<div class="card-footer"><span class="card-stars">⭐ ' + formatStars(tool.stars) + '</span></div>';
      html += '</div></div>';
    });
    html += '</div>';
  } else {
    html += '<div class="empty-state"><div class="empty-state-icon">🛠️</div><p>暫時未能獲取工具</p></div>';
  }
  html += '</div>';
  
  html += '<footer>🤖 AI 新聞速遞 | 每日自動更新</footer>';
  html += '</div></body></html>';
  
  return html;
}
