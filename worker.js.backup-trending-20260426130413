  html += "<script>";
  html += 'function switchTab(tabName) { document.querySelectorAll(".tab").forEach(function(t){t.classList.remove("active")}); document.querySelectorAll(".content-section").forEach(function(s){s.classList.remove("active")}); document.querySelector(".tab-" + tabName).classList.add("active"); document.querySelector(".section-" + tabName).classList.add("active"); };';
  html += 'function sanitize(s) { s=String(s||"").replace(/[<>]/g,function(c){return c=="<"?"&lt;":">";}).replace(/\uFF1B/g,";");return s;};';
  html += 'function setLang(lang) { document.querySelectorAll(".lang-btn").forEach(function(b){b.classList.remove("active")}); document.querySelector(".lang-btn-" + lang).classList.add("active"); document.querySelectorAll(".card-title").forEach(function(el){el.innerHTML=lang==="zh"?(sanitize(el.dataset.titleZh||el.dataset.nameZh)||sanitize(el.dataset.origTitle||el.dataset.origName)):sanitize(el.dataset.origTitle||el.dataset.origName);}); document.querySelectorAll(".card-summary").forEach(function(el){el.innerHTML=lang==="zh"?(sanitize(el.dataset.summaryZh||el.dataset.descZh)||sanitize(el.dataset.origSummary||el.dataset.origDesc)):sanitize(el.dataset.origSummary||el.dataset.origDesc);}); };';
  html += 'document.querySelectorAll(".card-title, .card-summary").forEach(function(el){if(!el.dataset.origTitle&&!el.dataset.origName)el.dataset.origTitle=el.textContent;if(!el.dataset.origSummary&&!el.dataset.origDesc)el.dataset.origSummary=el.textContent;});';
