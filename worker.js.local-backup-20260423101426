function getGithubApiUrl() {
  const yesterday = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString().split('T')[0];
  const query = encodeURIComponent(GITHUB_TOOLS_QUERY_BASE + ` pushed:>${yesterday}`);
