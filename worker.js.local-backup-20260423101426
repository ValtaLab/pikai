// ============ MyMemory Translate (free, supports zh-TW for Traditional Chinese) ============
async function translateWithMyMemory(text, fromLang = 'en', toLang = 'zh-TW') {
  if (!text || text.length < 2) return { success: false, text: null };
  try {
    const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text.substring(0, 200))}&langpair=${fromLang}|${toLang}`;
    const resp = await Promise.race([
      fetch(url, { signal: AbortSignal.timeout(6000) }),
      new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 6000))
    ]);
    if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
    const data = await resp.json();
    if (data && data.responseData && data.responseData.translatedText) {
      return { success: true, text: data.responseData.translatedText };
    }
    return { success: false, text: null };
  } catch (e) {
    return { success: false, text: null, error: e.message };
  }
}

// ============ Translation with Cache + Retry ============

// Cache translation in KV for 24 hours
async function getCachedTranslation(env, text, langKey) {
  const cacheKey = `trans:${langKey}:${md5(text.substring(0, 100))}`;
  const cached = await env.AI_NEWS_KV.get(cacheKey);
  if (cached) {
    console.log(`[Cache HIT] ${text.substring(0, 30)}...`);
    return cached;
  }
  return null;
}

async function setCachedTranslation(env, text, langKey, translatedText) {
  const cacheKey = `trans:${langKey}:${md5(text.substring(0, 100))}`;
  // Cache for 24 hours (86400 seconds)
  await env.AI_NEWS_KV.put(cacheKey, translatedText, { expirationTtl: 86400 });
}

async function translateWithBaidu(text, fromLang = 'en', toLang = 'zh', env = null, cacheKey = '') {
  if (!text || text.length < 2) return { success: false, text: null };
  
  // Check cache first if env is provided
  if (env && cacheKey) {
    const cached = await getCachedTranslation(env, text, cacheKey);
    if (cached) {
      return { success: true, text: cached, cached: true };
    }
  }
  
  // Retry with exponential backoff
  const maxRetries = 3;
  let lastError = null;
  
  for (let attempt = 0; attempt < maxRetries; attempt++) {
    try {
      const salt = Date.now() + attempt; // Add attempt to make salt unique
      const sign = md5(BAIDU_APP_ID + text.substring(0, 200) + salt + BAIDU_SECRET_KEY);
      const params = `?q=${encodeURIComponent(text.substring(0, 200))}&from=${fromLang}&to=${toLang}&appid=${BAIDU_APP_ID}&salt=${salt}&sign=${sign}`;
      const url = `https://fanyi-api.baidu.com/api/trans/vip/translate${params}`;
      
      const resp = await Promise.race([
        fetch(url, { signal: AbortSignal.timeout(5000) }),
        new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 5000))
      ]);
      
      if (!resp.ok) {
        // Rate limit or API error - wait and retry
        const waitTime = Math.pow(2, attempt) * 1000;
        console.log(`[Baidu API] HTTP ${resp.status}, retrying in ${waitTime}ms...`);
        lastError = new Error(`HTTP ${resp.status}`);
        await new Promise(r => setTimeout(r, waitTime));
        continue;
      }
      
      const data = await resp.json();
      
      // Check for Baidu-specific error codes
      if (data.error_code) {
        console.log(`[Baidu API] Error ${data.error_code}: ${data.error_msg || 'Unknown'}, retrying...`);
        const waitTime = Math.pow(2, attempt) * 1000;
        lastError = new Error(`Baidu error ${data.error_code}`);
        await new Promise(r => setTimeout(r, waitTime));
        continue;
      }
      
      if (data.trans_result && data.trans_result[0]) {
        const translatedText = data.trans_result[0].dst;
        // Cache successful translation
        if (env && cacheKey) {
          await setCachedTranslation(env, text, cacheKey, translatedText);
        }
        return { success: true, text: translatedText, cached: false };
      }
      
      return { success: false, text: null, error: 'No translation result' };
      
    } catch (e) {
      lastError = e;
      const waitTime = Math.pow(2, attempt) * 1000;
      console.log(`[Baidu translate] Attempt ${attempt + 1} failed: ${e.message}, retrying in ${waitTime}ms...`);
      if (attempt < maxRetries - 1) {
        await new Promise(r => setTimeout(r, waitTime));
      }
    }
  }
  
  // All retries exhausted
  console.log(`[Baidu translate] All retries failed for: ${text.substring(0, 30)}...`);
  return { success: false, text: null, error: lastError?.message || 'Max retries exceeded' };
}

async function translateNews(newsItems, env) {
  const translatedCount = { titles: 0, summaries: 0, cached: 0 };
  
  for (let i = 0; i < newsItems.length; i++) {
    const item = newsItems[i];
    
    // Translate title (use MyMemory for Traditional Chinese, with KV cache)
    let titleResult = null;
    if (env) {
      // Check KV cache first for title
      const cacheKeyTitle = `trans:my:title:${md5(item.title.substring(0, 100))}`;
      const cached = await env.AI_NEWS_KV.get(cacheKeyTitle);
      if (cached) {
        item.titleZh = cached;
        translatedCount.cached++;
        translatedCount.titles++;
        titleResult = { success: true, cached: true };
      }
    }
    if (!titleResult || !titleResult.success) {
      // Use MyMemory Translate for Traditional Chinese
      titleResult = await translateWithMyMemory(item.title, 'en', 'zh-TW');
      if (titleResult.success) {
        item.titleZh = titleResult.text;
        // Cache in KV for 24h
        if (env) {
          const cacheKeyTitle = `trans:my:title:${md5(item.title.substring(0, 100))}`;
          await env.AI_NEWS_KV.put(cacheKeyTitle, titleResult.text, { expirationTtl: 86400 });
        }
        translatedCount.titles++;
      } else {
        item.titleZh = null;
        console.log(`[WARN] Title translation failed: ${item.title.substring(0, 30)}...`);
      }
    }
    
    // Translate summary (only if has real summary)
    let summarySuccess = false;
    if (item.hasSummary && item.summary && item.summary.length > 10) {
      // Check KV cache first
      let summaryCached = false;
      if (env) {
        const cacheKeySummary = `trans:my:summary:${md5(item.summary.substring(0, 100))}`;
        const cachedSummary = await env.AI_NEWS_KV.get(cacheKeySummary);
        if (cachedSummary) {
          item.summaryZh = cachedSummary;
          translatedCount.cached++;
          translatedCount.summaries++;
          summarySuccess = true;
          summaryCached = true;
        }
      }
      if (!summaryCached) {
        let summaryResult = await translateWithMyMemory(item.summary.substring(0, 180), 'en', 'zh-TW');
        if (summaryResult.success) {
          item.summaryZh = summaryResult.text;
          // Cache in KV
          if (env) {
            const cacheKeySummary = `trans:my:summary:${md5(item.summary.substring(0, 100))}`;
            await env.AI_NEWS_KV.put(cacheKeySummary, summaryResult.text, { expirationTtl: 86400 });
          }
          translatedCount.summaries++;
          summarySuccess = true;
        } else {
          item.summaryZh = '🇬🇧 ' + item.summary.substring(0, 150);
          console.log(`[WARN] Summary translation failed: ${item.summary.substring(0, 30)}...`);
        }
      }
    } else {
      item.summaryZh = '📖 點擊閱讀全文 →';
    }
    
    console.log(`[${i+1}/${newsItems.length}] Title:${titleResult?.success ? '✓' : '✗'} Summary:${item.hasSummary && item.summary?.length > 10 ? (summarySuccess ? '✓' : '✗') : 'N/A'} ${item.title.substring(0, 25)}...`);
    
    // Rate limit protection: 500ms between requests
    await new Promise(r => setTimeout(r, 500));
  }
  
  console.log(`[Translation Summary] Titles: ${translatedCount.titles}/${newsItems.length}, Summaries: ${translatedCount.summaries}/${newsItems.filter(i => i.hasSummary).length}, Cached: ${translatedCount.cached}`);
  return newsItems;
}

