    if (cached) {
      const data = JSON.parse(cached);
      const age = Date.now() - new Date(data.cachedAt).getTime();
      if (age < CACHE_TTL_MS) {
        console.log(`[Cache] HIT tool: ${name}`);
        return data;
      }
      console.log(`[Cache] EXPIRED tool: ${name}`);
    }
  } catch (e) {
    console.log(`[Cache] Error reading tool cache: ${e.message}`);
  }
  return null;
}
