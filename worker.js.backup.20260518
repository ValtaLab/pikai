    const batchEnd = Math.min(batchStart + BATCH_SIZE, tools.length);
    console.log(`[translateTools] Processing batch ${Math.floor(batchStart/BATCH_SIZE) + 1}: ${batchStart}-${batchEnd-1}`);
    
