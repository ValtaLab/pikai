            console.log(`[Cache] Using cached translation for: ${item.title.substring(0, 40)}...`);
            summarizedNews.push({
              ...item,
              translatedTitle: cached.translatedTitle,
              summary: cached.summary,
              summarizedAt: new Date().toISOString()
            });
            continue;
          }
          
          // No cache - try Workers AI first
