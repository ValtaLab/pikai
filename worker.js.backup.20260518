async function fetchYouTubeVideos(env) {
  try {
    const apiKey = env.YOUTUBE_API_KEY;
    if (!apiKey) {
      console.log('[YouTube] No API key configured');
      return [];
    }
    
    // Check KV cache first (24 hours)
    const cacheKey = 'youtube:videos:v11';
    try {
      const cached = await env.AI_NEWS_KV.get(cacheKey);
      if (cached) {
        const data = JSON.parse(cached);
        const age = Date.now() - new Date(data.cachedAt).getTime();
        if (age < 24 * 60 * 60 * 1000) {
          console.log(`[YouTube] Cache hit: ${data.videos.length} videos`);
          return data.videos;
        }
      }
    } catch (e) {
      // Cache miss
    }
    
    // Calculate 7 days ago
    const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();
    
    // Step 1: Search for AI videos with 3 different queries
    const queries = [
      'AI+model+news+latest+2025+2026',
      'AI+innovative+applications+real+world+examples',
      'AI+tutorial+how+to+use+guide'
    ];
    
    const allVideoIds = [];
    for (const query of queries) {
      const searchUrl = `https://www.googleapis.com/youtube/v3/search?part=snippet&q=${query}&type=video&order=viewCount&publishedAfter=${encodeURIComponent(sevenDaysAgo)}&videoDuration=medium&maxResults=20&key=${apiKey}`;
      console.log(`[YouTube] Searching: ${query}`);
      const searchRes = await fetchWithTimeout(searchUrl, { headers: { 'Referer': 'https://ai-news-digest.isearover.workers.dev/' } }, 15000);
      if (searchRes.ok) {
        const searchData = await searchRes.json();
        const ids = (searchData.items || []).map(item => item.id.videoId).filter(Boolean);
        allVideoIds.push(...ids);
        console.log(`[YouTube] Query "${query}" returned ${ids.length} videos`);
      } else {
        console.error(`[YouTube] Search failed for "${query}": ${searchRes.status}`);
      }
    }
    
    // Deduplicate video IDs
    const videoIds = [...new Set(allVideoIds)];
    console.log(`[YouTube] Total unique videos: ${videoIds.length}`);
    
    if (videoIds.length === 0) {
      console.log('[YouTube] No videos found');
      return [];
    }
    
    // Step 2: Get video details (duration, viewCount)
    const detailsUrl = `https://www.googleapis.com/youtube/v3/videos?part=snippet,contentDetails,statistics&id=${videoIds.join(',')}&key=${apiKey}`;
    const detailsRes = await fetchWithTimeout(detailsUrl, { headers: { 'Referer': 'https://ai-news-digest.isearover.workers.dev/' } }, 15000);
    if (!detailsRes.ok) {
      console.error(`[YouTube] Details failed: ${detailsRes.status}`);
      return [];
    }
    const detailsData = await detailsRes.json();
    
    const videos = (detailsData.items || []).map(item => {
      const snippet = item.snippet || {};
      const stats = item.statistics || {};
      const duration = item.contentDetails?.duration || 'PT0S';
      
      // Parse ISO 8601 duration
      let durationStr = '';
      const match = duration.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
      if (match) {
        const h = parseInt(match[1] || 0);
        const m = parseInt(match[2] || 0);
        const s = parseInt(match[3] || 0);
        if (h > 0) durationStr += `${h}:`;
        durationStr += `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
      }
      
      const viewCount = parseInt(stats.viewCount || 0);
      let viewStr = '';
      if (viewCount >= 1000000) viewStr = (viewCount / 1000000).toFixed(1) + 'M';
      else if (viewCount >= 1000) viewStr = (viewCount / 1000).toFixed(1) + 'K';
      else viewStr = viewCount.toString();
      
      return {
        id: item.id,
        title: snippet.title || '',
        channel: snippet.channelTitle || '',
        thumbnail: snippet.thumbnails?.medium?.url || snippet.thumbnails?.default?.url || '',
        duration: durationStr,
        viewCount: viewStr,
        publishedAt: snippet.publishedAt || '',
        url: `https://youtube.com/watch?v=${item.id}`
      };
    }).filter(video => {
      // Filter out Shorts: duration < 5 minutes
      const parts = video.duration.split(':');
      let totalSeconds = 0;
      if (parts.length === 3) {
        totalSeconds = parseInt(parts[0]) * 3600 + parseInt(parts[1]) * 60 + parseInt(parts[2]);
      } else if (parts.length === 2) {
        totalSeconds = parseInt(parts[0]) * 60 + parseInt(parts[1]);
      }
      if (totalSeconds < 300) return false;
      
      // Filter by language: only English or Traditional Chinese titles
      const title = video.title || '';
      // Check for CJK characters (Chinese/Japanese/Korean)
      const hasCJK = /[\u4e00-\u9fff\u3400-\u4dbf]/.test(title);
      // Check for English characters
      const hasEnglish = /[a-zA-Z]/.test(title);
      // Reject non-target scripts (Arabic, Cyrillic, Thai, Japanese, Korean)
      const hasNonTargetScript = /[\u0600-\u06ff\u0750-\u077f\u0400-\u04ff\u0e00-\u0e7f\u3040-\u309f\u30a0-\u30ff\uac00-\ud7af]/.test(title);
      if (hasNonTargetScript) return false;
      
      // Reject common European language words (German, French, Spanish, etc.)
      // These indicate the title is likely not English
      const europeanWords = /\b(ist|benutzt|du|es|der|die|das|ein|eine|und|oder|nicht|mit|für|von|zu|auf|als|wie|wenn|dann|weil|aber|sondern|auch|noch|nur|schon|immer|schon|jetzt|hier|da|dort|heute|morgen|gestern| sehr|viel|wenig|mehr|meiste|besser|beste|neu|alt|gut|schlecht|groß|klein|lang|kurz|hoch|tief|breit|schmal|dick|dünn|schnell|langsam|früh|spät|leicht|schwer|teuer|billig|richtig|falsch|möglich|unmöglich|wichtig|unwichtig|interessant|langweilig|schön|hässlich|freundlich|unfreundlich|nett|gemein|mutig|feige|klug|dumm|fleißig|faul|sauber|schmutzig|gesund|krank|stark|schwach|müde|wach|hungrig|durstig|satt|heiß|kalt|warm|kühl|trocken|nass|hell|dunkel|laut|leise|hart|weich|glatt|rau|scharf|stumpf|frisch|alt|süß|sauer|bitter|salzig|mild|scharf|roh|gekocht|roh|lecker|ekelhaft)\b/gi;
      const euroMatch = title.match(europeanWords);
      if (euroMatch && euroMatch.length >= 2) return false;
      
      // Must have at least some English or Chinese characters
      return hasEnglish || hasCJK;
    });
    
    // Cache results
    try {
      await env.AI_NEWS_KV.put(cacheKey, JSON.stringify({ videos, cachedAt: new Date().toISOString() }), { expirationTtl: 24 * 60 * 60 });
    } catch (e) {
      console.log('[YouTube] Cache write failed:', e.message);
    }
    
    console.log(`[YouTube] Fetched ${videos.length} videos`);
    return videos;
  } catch (error) {
    console.error('[YouTube] Error:', error.message);
    return [];
  }
}
