      let cachedImage = null;
      try {
        cachedImage = await env.AI_NEWS_KV.get(cacheKey);
      } catch (e) {
        // KV miss or error, continue to fetch
      }
      if (cachedImage) {
        withImages.push({ ...item, ogImage: cachedImage === "none" ? null : cachedImage });
        continue;
      }
      // Fetch OG image with timeout
