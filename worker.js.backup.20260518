      try {
        // Check KV cache first
        const cached = await getCachedTool(tool.name, env);
        if (cached && cached.descZh) {
          console.log(`[Cache] Using cached tool summary for: ${tool.name}`);
          tool.nameZh = null; // Keep English name
          tool.descZh = cached.descZh;
          continue;
        }
        
        // No cache - try Workers AI first
        let result = await summarizeToolWithWorkersAI(
          tool.name,
          tool.description || '',
          env
        );
        
        // If Workers AI failed, try NVIDIA API
        if (!result.summary && env.NVIDIA_API_KEY) {
          console.log(`[Workers AI] Failed, trying NVIDIA for tool: ${tool.name}`);
          const prompt = `工具名稱：${tool.name}\n工具描述：${tool.description || ''}\n\n請用繁體中文簡短總結呢個工具嘅功能同用途（3-4句話，50字以內）。只輸出總結內容，唔需要標題。`;
          const nvidiaResult = await callNvidiaAPI(prompt, env.NVIDIA_API_KEY, 200);
          if (nvidiaResult.success) {
            result = { summary: nvidiaResult.text.trim() };
            console.log(`[NVIDIA] Tool summary: ${tool.name} → ${result.summary.substring(0, 30)}...`);
          }
        }
        
        if (result.summary && result.summary.length > 0) {
          tool.nameZh = null; // Keep English name
          tool.descZh = result.summary;
          // Save to KV cache
          await setCachedTool(tool.name, result.summary, env);
          console.log(`[translateTools] ${tool.name} → ${tool.descZh.substring(0, 30)}...`);
        } else {
          console.log(`[translateTools] ${tool.name} → no summary`);
          tool.nameZh = null;
          tool.descZh = null;
        }
      } catch (e) {
        console.log(`[translateTools] Failed for ${tool.name}: ${e.message}`);
        tool.nameZh = null;
        tool.descZh = null;
      }
    }
    
    // Delay between batches (except last)
    if (batchEnd < tools.length) {
      console.log(`[translateTools] Batch complete, waiting ${BATCH_DELAY}ms...`);
      await new Promise(resolve => setTimeout(resolve, BATCH_DELAY));
    }
  }
