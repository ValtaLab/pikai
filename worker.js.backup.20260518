// OpenRouter Rankings Scraper for Cloudflare Workers
async function scrapeOpenRouterRankings() {
  try {
    console.log('[OpenRouter] Fetching rankings...');
    
    const response = await fetch('https://openrouter.ai/rankings', {
      headers: {
        'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36'
      }
    });
    
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }
    
    const html = await response.text();
    const result = { usage: [], intelligence: [], coding: [], agentic: [] };
    
    // === 1. Extract Usage Rankings (Top Models) ===
    // Find rank 1 and extract the next 10 models from HTML
    const rank1Idx = html.indexOf('>1<!-- -->.');
    if (rank1Idx !== -1) {
      const segment = html.slice(rank1Idx, rank1Idx + 25000);
      
      const ranks = [...segment.matchAll(/>(\d+)<!-- -->\./g)].map(m => parseInt(m[1], 10));
      const models = [...segment.matchAll(/hover:underline\" href=\"\/([^\"]+)\"\u003e([^\u003c]+)<\/a\u003e/g)].map(m => ({ slug: m[1], name: m[2] }));
      const providers = [...segment.matchAll(/by<!-- --> <a[^\u003e]*href=\"\/([^\"]+)\"\u003e([^\u003c]+)<\/a\u003e/g)].map(m => m[2]);
      const tokens = [...segment.matchAll(/(<div>)?([\d.]+[TB])<!-- --> tokens/g)].map(m => m[2]);
      const changes = [...segment.matchAll(/inline w-3 text-(green|red)-9.*?([\d,]+)<!-- -->%/g)].map(m => ({
        trend: m[1] === 'green' ? '▲' : '▼',
        value: parseInt(m[2].replace(/,/g, ''), 10)
      }));
      
      const count = Math.min(ranks.length, models.length, providers.length, tokens.length, changes.length, 10);
      for (let i = 0; i < count; i++) {
        result.usage.push({
          rank: ranks[i],
          model: models[i].name,
          provider: providers[i],
          tokens: tokens[i] + ' tokens',
          change: changes[i].value,
          trend: changes[i].trend
        });
      }
      console.log(`[OpenRouter] Usage rankings: ${result.usage.length} models`);
    }
    
    // === 2. Extract Intelligence/Coding/Agentic from RSC payload ===
    const dataMarker = '\\"data\\":{';
    const dataIdx = html.indexOf(dataMarker);
    if (dataIdx !== -1) {
      const jsonStart = html.indexOf('{', dataIdx);
      if (jsonStart !== -1) {
        let depth = 0;
        let jsonEnd = -1;
        for (let i = jsonStart; i < html.length; i++) {
          if (html[i] === '{') depth++;
          else if (html[i] === '}') {
            depth--;
            if (depth === 0) {
              jsonEnd = i + 1;
              break;
            }
          }
        }
        
        if (jsonEnd !== -1) {
          let jsonStr = html.slice(jsonStart, jsonEnd);
          jsonStr = jsonStr.replace(/\\"/g, '"').replace(/\\\\/g, '\\');
          
          try {
            const parsed = JSON.parse(jsonStr);
            
            const extractTop10 = (arr) => {
              if (!Array.isArray(arr)) return [];
              return arr.slice(0, 10).map((item, idx) => ({
                rank: idx + 1,
                model: item.aa_name || item.uid || 'Unknown',
                slug: item.permaslug || item.heuristic_openrouter_slug || item.uid || '',
                score: item.score || 0
              }));
            };
            
            result.intelligence = extractTop10(parsed.intelligence);
            result.coding = extractTop10(parsed.coding);
            result.agentic = extractTop10(parsed.agentic);
            
            console.log(`[OpenRouter] Intelligence: ${result.intelligence.length}, Coding: ${result.coding.length}, Agentic: ${result.agentic.length}`);
          } catch (e) {
            console.warn('[OpenRouter] JSON parse error:', e.message);
          }
        }
      }
    }
    
    // If nothing extracted, use fallback
    if (result.usage.length === 0 && result.intelligence.length === 0) {
      console.warn('[OpenRouter] No data extracted, using fallback');
      return getFallbackRankings();
    }
    
    return result;
  } catch (error) {
    console.error('[OpenRouter] Scraping failed:', error.message);
    return getFallbackRankings();
  }
}
__name(scrapeOpenRouterRankings, 'scrapeOpenRouterRankings');

